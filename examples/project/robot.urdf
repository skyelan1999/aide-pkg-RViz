<?xml version="1.0"?>
<robot name="rviz_guided_demo">
  <link name="base_link">
    <visual><origin xyz="0 0 0.12"/><geometry><box size="0.7 0.5 0.24"/></geometry><material name="body"><color rgba="0.38 0.65 0.78 1"/></material></visual>
  </link>
  <link name="acceptance_laser">
    <visual><geometry><cylinder radius="0.08" length="0.1"/></geometry><material name="lidar"><color rgba="0.95 0.68 0.3 1"/></material></visual>
  </link>
  <joint name="fixed_lidar" type="fixed"><parent link="base_link"/><child link="acceptance_laser"/><origin xyz="1.25 0 0.4"/></joint>
</robot>
